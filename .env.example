# Kopieren nach .env.local (wird nicht eingecheckt). Keine Geheimnisse mit VITE_-Präfix –
# alles mit VITE_ landet im ausgelieferten JavaScript und ist öffentlich sichtbar.

# Öffentliche Basis-URL (ohne Slash am Ende) für canonical, og:url und sitemap.xml.
# Leer lassen, solange die Domain nicht feststeht.
SITE_URL=

# Online-Schadenmeldung freischalten – erst wenn Backend, Datenschutz und Sicherheit fertig sind.
VITE_DAMAGE_REPORT_ENABLED=false

# Später serverseitig (Cloudflare Pages → Settings → Variables and Secrets, NICHT hier eintragen):
# TURNSTILE_SECRET_KEY=
# NOTIFY_EMAIL=
