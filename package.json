{
  "name": "nd-gutachterbuero-dekic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node --env-file-if-exists=.env.local scripts/prerender.mjs",
    "lint": "oxlint src functions scripts tests",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "e2e": "node tests/e2e/run.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "gsap": "^3.15.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.49.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "description": "Website Gutachterbüro Dekic – Kfz-Sachverständige in Norddeutschland"
}
